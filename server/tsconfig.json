{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test",
    "e2e",
    "../src/types/slides.ts",
    "../src/types/outline.ts",
    "../src/utils/outline"
  ],
  "exclude": [
    "../src/utils/outline/viewSchema.ts",
    "../src/utils/outline/pendingSteps.ts",
    "../src/utils/outline/syncCore.ts",
    "test/outline-request-adapter.test.ts"
  ]
}
